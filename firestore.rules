rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.token.email == 'vladpetrenko66@gmail.com';
    }
    // Копія розбору для клієнта: читати можна лише за точним довгим кодом, переглянути список не можна.
    match /shared/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if owner();
    }
    match /{document=**} {
      allow read, write: if owner();
    }
  }
}
